# Copy to .env at the repository root. Never commit a real API key.
SMW_LLM_BACKEND=openai_compatible
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=replace-with-your-model-id
SMW_EXECUTION_PROFILE=cloud_fast
# Receive long responses incrementally; disable only for endpoints without SSE.
SMW_OPENAI_STREAM=true

# Keep the same identity and local store across import and generation.
MEM0_QDRANT_SUMMARY_PATH=./qdrant_summary
MEM0_SUMMARY_COLLECTION=meeting_memory
